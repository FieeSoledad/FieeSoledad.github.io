---
const { title = 'Fiee Soledad', description = '记录生活、思考与创造。' } = Astro.props;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="icon" href="data:," />
    <title>{title} · Fiee Soledad</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/">Fiee<span>·</span>Soledad</a>
      <nav><a href="/">首页</a><a href="/archives/">日期归档</a><a href="/categories/">分类</a><a href="/rss.xml">RSS</a></nav>
    </header>
    <main><slot /></main>
    <footer>© {new Date().getFullYear()} Fiee Soledad · Built with Astro</footer>
  </body>
</html>
<style is:global>
@import url('https://fonts.googleapis.com/css2?family=DM+Mono:wght@400&family=DM+Sans:wght@400;500;700&family=Noto+Serif+SC:wght@400;600;700&display=swap');
:root{--ink:#20221f;--muted:#777a72;--line:#deded5;--accent:#d56b4c;--paper:#f8f8f3}*{box-sizing:border-box}html{background:var(--paper)}body{margin:0;color:var(--ink);font-family:'DM Sans','Noto Serif SC',sans-serif}a{color:inherit;text-decoration:none}.site-header{max-width:1080px;margin:auto;padding:30px 28px;display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid var(--line)}.brand{font-size:21px;font-weight:700;letter-spacing:-.04em}.brand span{color:var(--accent);padding:0 3px}nav{display:flex;gap:25px;color:var(--muted);font-size:14px}nav a:hover{color:var(--accent)}main{max-width:1080px;margin:auto;padding:70px 28px 100px}footer{border-top:1px solid var(--line);max-width:1024px;margin:auto;padding:25px 28px;color:var(--muted);font:12px 'DM Mono',monospace}.eyebrow{font:12px 'DM Mono',monospace;color:var(--accent);letter-spacing:.08em;text-transform:uppercase}.hero{max-width:700px;margin-bottom:75px}.hero h1{font:600 clamp(42px,7vw,78px)/1.05 'Noto Serif SC',serif;letter-spacing:-.06em;margin:16px 0 20px}.hero p{color:var(--muted);font-size:17px;line-height:1.8}.section-title{font-size:13px;color:var(--muted);letter-spacing:.1em;text-transform:uppercase;margin-bottom:18px}.post-list{border-top:1px solid var(--line)}.post-item{display:grid;grid-template-columns:135px 1fr;gap:28px;padding:25px 0;border-bottom:1px solid var(--line)}.post-item time{font:12px 'DM Mono',monospace;color:var(--muted);padding-top:6px}.post-item h2{margin:0 0 8px;font:600 25px 'Noto Serif SC',serif}.post-item p{margin:0;color:var(--muted);line-height:1.7}.tags{display:flex;gap:8px;margin-top:13px}.tag{font:11px 'DM Mono',monospace;color:var(--accent)}.article{max-width:760px;margin:auto}.article-header{margin-bottom:50px}.article h1{font:600 clamp(38px,6vw,64px)/1.15 'Noto Serif SC',serif;letter-spacing:-.05em;margin:15px 0}.article-meta{color:var(--muted);font:12px 'DM Mono',monospace}.prose{font:17px/2 'Noto Serif SC',serif}.prose h2{font-size:26px;margin:45px 0 12px}.prose p{margin:0 0 22px}.prose code{background:#ecece5;padding:2px 6px;border-radius:3px;font:14px 'DM Mono',monospace}.prose pre{background:#272923;color:#f5f4eb;padding:22px;overflow:auto;border-radius:5px}.prose a{color:var(--accent);text-decoration:underline;text-underline-offset:4px}.archive-year{font:600 38px 'Noto Serif SC',serif;margin:0 0 28px}.archive-list{max-width:760px}.archive-list a{display:flex;justify-content:space-between;padding:18px 0;border-bottom:1px solid var(--line)}.archive-list time{color:var(--muted);font:12px 'DM Mono',monospace}@media(max-width:600px){.site-header{padding:22px 20px}nav{gap:13px}main{padding:50px 20px 75px}.post-item{grid-template-columns:1fr;gap:6px}.post-item time{padding:0}.hero{margin-bottom:55px}}
.prose pre{background:#f0f0eb!important;color:#20221f!important;border:1px solid #deded5}.prose pre,.prose pre *{background-color:transparent!important;color:#20221f!important}.prose pre code{display:block;padding:0!important}
</style>
