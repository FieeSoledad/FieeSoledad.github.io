---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
export async function getStaticPaths(){ const posts = await getCollection('posts', ({data}) => !data.draft); const categories = [...new Set(posts.map(post => post.data.category))]; return categories.map(category => ({ params:{category}, props:{ category, posts:posts.filter(post => post.data.category === category).sort((a,b)=>b.data.published.valueOf()-a.data.published.valueOf())} })); }
const { category, posts } = Astro.props;
---
<Layout title={category}><div class="eyebrow">Category</div><h1 class="archive-year">{category}</h1><section class="post-list">{posts.map(post => <a class="post-item" href={`/blog/${post.id}/`}><time>{post.data.published.toLocaleDateString('zh-CN')}</time><div><h2>{post.data.title}</h2><p>{post.data.description}</p></div></a>)}</section></Layout>
